	<!-- [%] 为角色名或地点，[@] 为身体部位或门名称 -->
	<uihint>
		<!-- [whos] [body part] Crippled -->
		<bptd format="[%]的[@]残废了" />
		<!-- [door] to [place] -->
		<door format="通往[%]的[@]" />
	</uihint>

	<perkrequirements>
		<req><![CDATA[需求]]></req>
		<ranks><![CDATA[级别]]></ranks>
		<source><![CDATA[来源]]></source>
		<levelSuffix><![CDATA[级]]></levelSuffix>
		<and><![CDATA[且]]></and>
		<or><![CDATA[或]]></or>
		<not><![CDATA[没有]]></not>
	</perkrequirements>

	<regularexpressions>
		<!-- 前后缀预处理 -->
		<config id="TrimPrefixRegularExpressions"><![CDATA[^(<GID[0-9]+> *|<tNVSE [^>\t]+> *| +|> )]]></config>
		<config id="TrimSuffixRegularExpressions"><![CDATA[([ ]*)$]]></config>
		<config id="BypassPrefixRegularExpressions"><![CDATA[^(\[(?!Return)[a-zA-Z0-9,%\$\/ -]+\]|Req: .*(?:Ranks: [0-9]+)?|<.+>)]]></config>
		<config id="BypassSuffixRegularExpressions"><![CDATA[(\+| >| \(\d+\))$]]></config>

		<!-- 添加物品角落信息 -->
		<regex from="^(\d+) ([\s\S]+)\(s\)(?: \n| )added$" to="已添加$1个$2"/>
		<regex from="^([\s\S]+) \n?added$" to="已添加$1"/>

		<!-- 移除物品角落信息 -->
		<regex from="^(\d+) ([\s\S]+)\(s\)(?: \n| )removed$" to="已移除$1个$2"/>
		<regex from="^([\s\S]+) \n?removed$" to="已移除$1"/>

		<!-- 技能增加角落信息 -->
		<regex from="([\s\S]+) \n?increased \n?by \n?(\d+)$" to="$1 增加了$2点"/>

		<!-- 时间 -->
		<regex from="^(\w+), (\d{1,2})\.(\d{1,2})\.(\d{2,4}),\s(\d{1,2}):(\d{1,2})(\sAM|\sPM)?$" to="$4.$2.$3 $1$7 $5:$6" />

		<!-- 技能书效果提示 -->
		<regex from="Permanent ([\s\S]+)\s+([\+|-])(\d+)" to="$1永久 $2$3" />

		<!-- 赌场收入提示 -->
		<regex from="^\s*([^\:]+)\s*Earnings:\s+(\-?\d+)$" to="在$1的收入:    $2"/>

		<!-- 禁止赌博提示 -->
		<regex from="^([\d]+)\s([\s\S]+)\(s\)\s+added\s*You have been banned from gambling at this casino.$" to="已添加 $1个$2&#xA;这个赌场已禁止你继续在此赌博。"/>

		<!-- 阵营声望 -->
		<regex from="^([\w\s]+)\s+Fame:\s+(\d+)%\s+-\s+Infamy:\s+(\d+)%$" to="$1&#xA;声望: $2% - 恶名: $3%"/>

		<!-- SD_transpoter菜单 -->
		<regex from="^(.+):\s(\d+)\sCaps$" to="$1：$2 瓶盖"/>

		<!-- Claim the Mojave -->
		<regex from="([^\r\n]+?)\s+is\s+now\s+under\s+the\s+control\s+of\s+([^\r\n]+?)$" to="$1已由$2控制"/>
		<regex from="([^\r\n]+?)\s+is\s+returning\s+to\s+([^\r\n]+?)$" to="$1正在返回$2"/>
		<regex from="([^\r\n]+?)\s+has\s+returned\s+to\s+([^\r\n]+?)$" to="$1已返回$2"/>

		<!-- JIP CCC -->
		<regex from="^([\s\S]+) is at ([\s\S]+)$" to="$1位于$2"/>

		<!-- Ammo Box -->
		<regex from="^([\S\s]+)\sBox\s\n?(\[\d+\])$" to="$1弹药盒 $2"/>
		<regex from="^([\S\s]+)\sBox\s\n?(\[\d+\]\s\n?\(\d+\))$" to="$1弹药盒 $2"/>

		<!-- Dialogue History - ESPless -->
		<regex from="^([0-9]{1,2}):([0-9]{2})\s*-\s*(.+)$" to="$1:$2 - $3"/>
		<regex from="^([0-9]{1,2})(?:st|nd|rd|th)\s+of\s+([A-Za-z]+),\s*([0-9]{4})$" to="$3年$2$1日"/>
		<regex from="^([0-9]{1,2})(?:st|nd|rd|th)\s+of\s+([A-Za-z]+),\s([0-9]{4})\s-\s([0-9]{1,2}):([0-9]{2})\s-\s([^\r\n]+)$" to="$3年$2$1日 - $4:$5 - $6"/>
		<regex from="^([^\r\n]+?)\s-\s([A-Za-z]+),\s([0-9]{1,2}):([0-9]{2})\s([AaPp][Mm]),\s([0-9]{1,2})(?:st|nd|rd|th)\s+of\s+([A-Za-z]+),\s([0-9]{4})$" to="$1 - $8年$7$6日，$3:$4 $5（$2）"/>
	</regularexpressions>
</tNVSE>
