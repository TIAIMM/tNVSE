<!--
	tNVSE native IME display menu.

	Class 1079 is the high unused gap in the engine's valid 1001-1084 Menu
	table and is supplied by tNVSE's chained Menu factory while this XML is
	being parsed.  The non-stacking, non-targetable Menu keeps native
	TileMenu ownership; tNVSE excludes its scene node only from the Pip-Boy
	render-to-texture pass and restores it for normal screen composition.
-->
<menu name="tNVSE_IME">
	<class> 1079 </class>
	<stackingtype> &does_not_stack; </stackingtype>
	<visible> &false; </visible>
	<target> &false; </target>
	<clips> &false; </clips>
	<locus> &true; </locus>
	<width> 620 </width>
	<height> 284 </height>
	<x>
		<copy src="screen" trait="width"/>
		<sub src="me" trait="width"/>
		<div> 2 </div>
		<max> 12 </max>
	</x>
	<y>
		<copy src="screen" trait="height"/>
		<mul> 0.58 </mul>
		<min>
			<copy src="screen" trait="height"/>
			<sub src="me" trait="height"/>
			<sub> 12 </sub>
		</min>
	</y>
	<depth> 0 </depth>

	<image name="tNVSE_IME_Background">
		<filename> Interface\Shared\solid.dds </filename>
		<texatlas> Interface\InterfaceShared.tai </texatlas>
		<zoom> &scale; </zoom>
		<visible> &true; </visible>
		<target> &false; </target>
		<x> 0 </x>
		<y> 0 </y>
		<width> 620 </width>
		<height> 284 </height>
		<red> 18 </red>
		<green> 18 </green>
		<blue> 18 </blue>
		<alpha> 232 </alpha>
		<systemcolor> &nosystemcolor; </systemcolor>
		<depth> 0 </depth>
	</image>

